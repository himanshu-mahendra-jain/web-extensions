{
    "manifest_version": 3,
    "name": "Clear Browsing Data Except Kept Sites",
    "version": "1.0.1",
    "minimum_chrome_version": "119",
    "default_locale": "en",
    "description": "__MSG_extensionDescription__",
    "homepage_url": "https://github.com/himanshu-mahendra-jain/web-extensions",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Clear Browsing Data Except Kept Sites",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "browsingData",
        "cookies",
        "history",
        "storage"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "options_page": "options/options.html",
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
}
