{
    "manifest_version": 3,
    "name": "Enable Copy and Right Click",
    "version": "1.0.3",
    "default_locale": "en",
    "description": "__MSG_extensionDescription__",
    "homepage_url": "https://github.com/himanshu-mahendra-jain/web-extensions",
    "developer": {
        "name": "Himanshu Mahendra Jain",
        "url": "https://github.com/himanshu-mahendra-jain/web-extensions"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "enable-copy-and-right-click@himanshu-mahendra-jain",
            "strict_min_version": "153.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "153.0"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Enable Copy and Right Click",
        "default_area": "navbar",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "commands": {
        "enable-copy-right-click": {
            "suggested_key": {
                "windows": "Alt+C",
                "linux": "Alt+C",
                "mac": "Command+Shift+Y"
            },
            "description": "__MSG_commandDescription__"
        }
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "scripts": [
            "src/background.js"
        ],
        "type": "module"
    },
    "options_page": "options/options.html",
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
}
